{
  "name": "mh-cea-tool",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Antipsychotic Medication Cost-Effectiveness and Budget Tool (CHAI Mental Health): public validation version, September 2026",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:single": "vite build --mode single",
    "data:attachment": "python tools/build_public.py --rules data/public/redactions.report-attachment.json --out data/report-attachment",
    "build:attachment-single": "npm run data:attachment && vite build --mode report-attachment-single"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.8"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chai-luke/mh-cea-tool"
  }
}
